{
  "_comment": "运行时入口清单（示例部署）：记录外部消费者期望的运行时入口，供 scripts/tools/check_runtime_entrypoints.py 只读校验。不含凭据/令牌/主机名。repo_root 为部署根（unit 文件内绝对路径前缀），部署时按需替换。生产侧的实际安装状态（systemctl list-timers / 已安装 unit）应由巡检流程另行核对。",
  "repo_root": "/srv/treasury",
  "interpreter_default": "/usr/bin/python3",
  "units": {
    "personal-treasury-feishu-digest.service": {
      "timer": "personal-treasury-feishu-digest.timer",
      "on_calendar": "*-*-* 08:15:00 Europe/Berlin",
      "exec": "scripts/tools/feishu_digest.py",
      "exec_post": "scripts/tools/deliver_feishu_digest.py",
      "note": "日报调度入口示例；生成+投递两步（ExecStartPost 串联）"
    },
    "personal-treasury-patrol.service": {
      "timer": "personal-treasury-patrol.timer",
      "on_calendar": "*-*-* 00/6:00:00 Europe/Berlin",
      "exec": "scripts/ops/health-check.sh",
      "note": "巡检入口；替代旧 watchdog timer（新旧不同时启用）"
    },
    "personal-treasury-backup.service": {
      "timer": "personal-treasury-backup.timer",
      "on_calendar": "*-*-* 02:30:00 Europe/Berlin",
      "exec": "scripts/ops/backup.sh",
      "note": "ExecStart 经 flock -n 包装"
    },
    "personal-treasury-backup-stalecheck.service": {
      "timer": "personal-treasury-backup-stalecheck.timer",
      "on_calendar": "*-*-* 00,06,12,18:00:00 Europe/Berlin",
      "exec": "scripts/ops/stalecheck.sh"
    },
    "personal-treasury-backup-alert@.service": {
      "exec": "scripts/ops/notify.sh",
      "note": "OnFailure 模板 unit，无 timer"
    },
    "personal-treasury-fx-refresh.service": {
      "timer": "personal-treasury-fx-refresh.timer",
      "on_calendar": "*-*-* 07:40:00 Europe/Berlin",
      "exec_container_module": "finance_bridge.scripts.refresh_fx_rates",
      "note": "ECB 汇率刷新；入口为 bridge 容器内模块，非仓库脚本路径，故不声明 exec。触发时刻与整点巡检错开，避免同刻启动的竞态。"
    }
  },
  "external_consumers": {
    "chat_agent_finance_mcp": {
      "script": "finance_bridge/mcp_server.py",
      "note": "聊天助手 Agent 经 MCP 接入（stdio）"
    },
    "firefly_cron_container": {
      "script": null,
      "note": "Firefly 内置 cron 容器，非仓库脚本入口"
    }
  },
  "retired_units": {
    "personal-treasury-watchdog.service": {
      "timer": "personal-treasury-watchdog.timer",
      "on_calendar": "*-*-* 00,06,12,18:05:00 Europe/Berlin",
      "note": "退役 unit 示例：职责并入 patrol。仓库刻意不保留其 unit 文件；登记于此以区分「有意退役」与「忘记登记」，卸载属独立的运维动作。"
    }
  }
}
