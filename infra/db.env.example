# MariaDB variable reference fragment
#
# infra/compose.yaml does NOT automatically read a db.env file. For an actual
# deployment, copy these variable names into the untracked infra/.env together
# with all other values shown in infra/.env.example.
#
# Never commit real passwords.

DB_ROOT_PASSWORD=CHANGE_ME_generate_a_unique_root_password
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=CHANGE_ME_generate_a_unique_database_password
