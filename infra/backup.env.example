# Personal ERP — Backup configuration
# Deploy to: /etc/personal-treasury/backup.env (root:root 0600)
# DO NOT commit real values to version control.

# --- GPG Encryption ---
# Full 40-character fingerprint of the backup encryption public key.
# The private key must NOT be on this server.
BACKUP_GPG_FINGERPRINT="ABCD1234EF567890ABCD1234EF567890ABCD1234"

# --- Remote Upload (SSH streaming) ---
# SSH config alias for the backup server (configured in /root/.ssh/config)
BACKUP_REMOTE_HOST="backup-server"
# Inbox directory on the backup server (written via forced command)
BACKUP_REMOTE_INBOX="/var/backups/personal-treasury/inbox"

# --- Local Retention ---
# Where encrypted backups are kept locally after successful upload
BACKUP_LOCAL_DIR="/var/backups/personal-treasury"
# Days to retain local encrypted backups
BACKUP_RETENTION_DAILY=7

# --- Docker Compose ---
COMPOSE_FILE="/opt/personal-treasury/infra/compose.yaml"

# --- State Directory ---
# Used by systemd StateDirectory; stores last_success, failure JSON, failures.log
STATE_DIR="/var/lib/personal-treasury-backup"

# --- Alerting ---
# Alerts are sent via `hermes send --to feishu` (no configuration needed).
# Failures are always logged to STATE_DIR/failures.log regardless.
