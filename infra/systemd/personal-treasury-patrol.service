[Unit]
Description=Personal Treasury patrol: health-check.sh
# 巡检唯一执行入口 = scripts/ops/health-check.sh（已并入原 watchdog.sh 的
# freshness / 必需容器 / 告警职责）。新旧巡检不得同时启用。
# 失败告警由脚本内通知命令尽力投递并记入 journal；退出码非 0 即巡检失败。
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/treasury
Environment=REPO_ROOT=/srv/treasury
# HERMES_BIN 绝对路径（systemd PATH 不含 ~/.local/bin）；与 digest 共用 env 文件
EnvironmentFile=/etc/treasury/digest.env
# 生产环境才允许真实告警投递；本地/开发缺省不发送（防误发）
Environment=PATROL_ALERT_ENABLED=1
ExecStart=/usr/bin/env bash /srv/treasury/scripts/ops/health-check.sh
UMask=0077
TimeoutStartSec=180
