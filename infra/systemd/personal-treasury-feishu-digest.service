[Unit]
Description=Personal Treasury daily digest (generate + deliver)
# systemd 是日报唯一调度者；不要在 cron 或其他调度器中重复调度。
# 生成与投递拆为两步、可独立失败：
#   ExecStart      生成（feishu_digest.py）→ 状态文件 <业务日>.txt
#   ExecStartPost  投递（deliver_feishu_digest.py）→ 幂等回执
# ExecStart 失败时 ExecStartPost 不会运行（生成失败不发送）。
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/treasury
Environment=REPO_ROOT=/srv/treasury
# 从独立 env 读取 BRIDGE_INTERNAL_TOKEN / BRIDGE_BASE_URL / HERMES_BIN / HERMES_HOME
EnvironmentFile=/etc/treasury/digest.env
# systemd 默认 PATH 不含 ~/.local/bin：HERMES_BIN 必须是绝对路径。
ExecStart=/usr/bin/python3 /srv/treasury/scripts/tools/feishu_digest.py
ExecStartPost=/usr/bin/python3 /srv/treasury/scripts/tools/deliver_feishu_digest.py
UMask=0077
# 生成（多次接口调用）+ 投递的总时长上限
TimeoutStartSec=300
