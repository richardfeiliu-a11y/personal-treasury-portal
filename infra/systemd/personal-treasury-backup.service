[Unit]
Description=Personal ERP daily backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=personal-treasury-backup-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/personal-treasury
Environment=REPO_ROOT=/opt/personal-treasury
EnvironmentFile=/etc/personal-treasury/backup.env
ExecStart=/usr/bin/flock -n /run/lock/personal-treasury-backup.lock /opt/personal-treasury/scripts/ops/backup.sh
UMask=0077
TimeoutStartSec=30min
StateDirectory=personal-treasury-backup
StateDirectoryMode=0700
