[Unit]
Description=Personal Treasury daily backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=personal-treasury-backup-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/srv/treasury
Environment=REPO_ROOT=/srv/treasury
EnvironmentFile=/etc/treasury/backup.env
ExecStart=/usr/bin/flock -n /run/lock/treasury-backup.lock /srv/treasury/scripts/ops/backup.sh
UMask=0077
TimeoutStartSec=30min
StateDirectory=treasury-backup
StateDirectoryMode=0700
