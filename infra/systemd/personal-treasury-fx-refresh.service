[Unit]
Description=Refresh ECB FX reference rates
# 在 bridge 容器内执行汇率刷新模块；由 check_runtime_entrypoints.py 与
# runtime-entrypoints.json 共同登记，避免「仅生产安装、仓库无登记」的漂移。
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/treasury
ExecStart=/usr/bin/docker compose -f /srv/treasury/infra/compose.yaml exec -T bridge python -m finance_bridge.scripts.refresh_fx_rates
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
