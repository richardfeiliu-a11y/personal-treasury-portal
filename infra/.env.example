# Personal Treasury Docker Compose environment template
# Copy to /srv/treasury/infra/.env and replace every CHANGE_ME value.
# Never commit the real .env or print its contents in logs/task replies.

# --- Firefly / MariaDB secrets ---
APP_KEY=CHANGE_ME_generate_a_unique_firefly_app_key
DB_ROOT_PASSWORD=CHANGE_ME_generate_a_unique_root_password
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=CHANGE_ME_generate_a_unique_database_password
STATIC_CRON_TOKEN=CHANGE_ME_generate_a_unique_cron_token

# --- Internal service authentication ---
BRIDGE_INTERNAL_TOKEN=CHANGE_ME_generate_a_long_random_bridge_token
FIREFLY_TOKEN=CHANGE_ME_create_a_firefly_personal_access_token

# --- 报表门户入口认证 ---
# report-web 容器本身不做登录：Nginx 不配置 Basic Auth，也不读取任何
# REPORT_AUTH_* 变量（见 report-web/Dockerfile 与 nginx.conf.template）。
# 参考部署的入口认证由边缘（Cloudflare Access 一次性邮件验证码）提供；
# 换用其他边缘/反代时，请在到达 report-web 之前自行实现等价的访问控制。
# 唯一必需的相关变量是下方 Cloudflare Tunnel token（不启用 tunnel 时留空）。

# --- Cloudflare Tunnel ---
# Leave empty only when cloudflared profile will not be started.
CLOUDFLARE_TUNNEL_TOKEN=

# Documentation/operations metadata. compose.yaml currently does not consume
# REPORT_HOSTNAME; it records the intended public hostname for operators.
REPORT_HOSTNAME=treasury.example.com

# --- Runtime settings (defaults match the reference deployment) ---
APP_URL=http://127.0.0.1:18080
APP_ENV=production
TZ=Europe/Berlin
BASE_CURRENCY=CNY
